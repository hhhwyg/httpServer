HTTPSERVER_BENCH_URL=ws://127.0.0.1:8088/ws
HTTPSERVER_BENCH_DURATION_SECONDS=86400
# Single-instance soak. Use the cross-instance scenario with a duration override
# for a two-node soak, pointing each endpoint at one specific instance.
# Chat connections = ROOMS * (ROOM_FANOUT + 1), here 404.
HTTPSERVER_BENCH_ROOM_FANOUT=100
HTTPSERVER_BENCH_ROOMS=4
HTTPSERVER_BENCH_MESSAGE_BYTES=256
HTTPSERVER_BENCH_IO_BACKEND=epoll
HTTPSERVER_BENCH_BUILD_TYPE=Release
HTTPSERVER_BENCH_SERVER_THREADS=6
HTTPSERVER_BENCH_CLIENT_LOCATION=same-host
HTTPSERVER_BENCH_AUTH_MODE=api
HTTPSERVER_BENCH_WORKLOAD=chat
# Controlled aggregate rate stays below default per-user message limits.
HTTPSERVER_BENCH_MESSAGE_RATE=10
HTTPSERVER_BENCH_SAMPLE_INTERVAL_SECONDS=5
