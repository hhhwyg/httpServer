# Source this file before starting docker-compose.scale.yml so the benchmark
# message-rate limit reaches both services. Senders connect to instance A and
# all receivers connect to instance B, so every measured delivery crosses Redis.
HTTPSERVER_BENCH_URL=ws://127.0.0.1:18080/ws
HTTPSERVER_BENCH_RECEIVER_URL=ws://127.0.0.1:18081/ws
HTTPSERVER_BENCH_DURATION_SECONDS=1800
# Chat connections = ROOMS * (ROOM_FANOUT + 1), here 404.
HTTPSERVER_BENCH_ROOM_FANOUT=100
HTTPSERVER_BENCH_ROOMS=4
HTTPSERVER_BENCH_MESSAGE_BYTES=256
HTTPSERVER_BENCH_IO_BACKEND=epoll
HTTPSERVER_BENCH_BUILD_TYPE=Release
HTTPSERVER_BENCH_SERVER_THREADS=2-per-instance
HTTPSERVER_BENCH_CLIENT_LOCATION=same-host
HTTPSERVER_BENCH_AUTH_MODE=api
HTTPSERVER_BENCH_CROSS_INSTANCE=1
HTTPSERVER_BENCH_WORKLOAD=chat
HTTPSERVER_BENCH_MESSAGE_RATE=0
HTTPSERVER_BENCH_SAMPLE_INTERVAL_SECONDS=5
HTTPSERVER_MESSAGE_MAX_ATTEMPTS=100000
