[Unit]
Description=httpServer HTTP and WebSocket service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=httpserver
Group=httpserver
WorkingDirectory=/opt/httpserver
EnvironmentFile=/etc/httpserver/httpserver.env
ExecStart=/opt/httpserver/WebServer -b epoll -p 8088 -l /var/log/httpserver/server.log
Restart=on-failure
RestartSec=5
TimeoutStopSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/httpserver
LimitNOFILE=100000

[Install]
WantedBy=multi-user.target
