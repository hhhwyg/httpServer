# Copy this file to .env for local reference, then export its values in your shell.
# Do not commit .env or production credentials.

# Generate a secret with: openssl rand -base64 48
HTTPSERVER_JWT_SECRET=
HTTPSERVER_JWT_ISSUER=httpServer
HTTPSERVER_JWT_TTL_SECONDS=3600

# Omit all DB variables to start without login and registration routes.
HTTPSERVER_DB_HOST=127.0.0.1
HTTPSERVER_DB_PORT=3306
HTTPSERVER_DB_USER=httpserver
HTTPSERVER_DB_PASSWORD=
HTTPSERVER_DB_NAME=webserver
HTTPSERVER_DB_POOL_SIZE=4
